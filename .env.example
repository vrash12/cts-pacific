# Public site configuration
# Keep localhost for local development. Use https://ctspacific.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ECOMMERCE_ENABLED=false

# PostgreSQL / Supabase (server only)
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Orders API (future commerce; server only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Enable only after PayPal confirms Advanced Card Payments eligibility.
PAYPAL_CARD_PAYMENTS_ENABLED=false

# Transactional email (Resend)
EMAIL_API_KEY=
EMAIL_FROM=CTS Pacific <quotes@your-verified-domain.com>
QUOTE_NOTIFICATION_EMAIL=info@corerintechnicalsolutions.com
CONTACT_NOTIFICATION_EMAIL=info@corerintechnicalsolutions.com

# Bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Future provider-agnostic assistant
AI_API_KEY=
